# AIRCOINS NETFI — hotspot RADIUS server (replaces sites-enabled/default).
#
# install.sh disables the stock default/inner-tunnel sites and enables
# this one. MikroTik hotspot clients authenticate with PAP (voucher code
# or MAC as both username and password, loaded from radcheck); the router
# is the only expected NAS.

# virtual_server = aircoins is REQUIRED on each top-level listen block:
# a top-level listen without it routes to the implicit virtual server
# named "default", which install.sh deletes, leaving an empty server with
# no authorize section -> "Empty authorize section" / "No Auth-Type found".
listen {
	type = auth
	ipaddr = *
	port = 1812
	virtual_server = aircoins
}

listen {
	type = acct
	ipaddr = *
	port = 1813
	virtual_server = aircoins
}

server aircoins {

	authorize {
		preprocess
		chap

		# Loads radcheck / radreply / radusergroup from SQLite. This is
		# what supplies Cleartext-Password (PAP) and Session-Timeout.
		sql

		expiration
		logintime

		# PAP stays LAST: it verifies against what sql loaded above.
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type CHAP {
			chap
		}
	}

	accounting {
		sql
	}

	session {
		sql
	}

	post-auth {
		# Writes radpostauth (without passwords) and returns the reply.
		sql

		Post-Auth-Type REJECT {
			sql
		}
	}

	pre-proxy {
	}

	post-proxy {
	}
}
